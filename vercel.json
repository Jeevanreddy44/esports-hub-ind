{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/api/:path*",
          "destination": "@backend"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "buildCommand": "npm install",
      "startCommand": "node server.js"
    }
  }
}
